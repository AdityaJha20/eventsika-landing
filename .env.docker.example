# Eventsika — Docker environment template (PLACEHOLDERS ONLY).
#
# Copy to `.env.docker` (git-ignored, docker-ignored) and fill in values from a
# DEVELOPMENT / STAGING project. Never use production payment or database
# credentials for local Docker work.
#
#   Copy-Item .env.docker.example .env.docker
#
# Every variable is optional for the container to START. Features whose
# variables are blank return 503 or fall back as described in README.md.
# All values here are read at RUNTIME by the server; none are baked into images.

# --- Site ----------------------------------------------------------------
# Public. Used by robots.txt / sitemap.xml (defaults to https://eventsika.in).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Postgres + Auth) -------------------------------------------
# Server reads SUPABASE_URL first, then NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable/anon key (admin login session cookies).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PRIVATE. Server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting -------------------------------------------------------
# "upstash" (production default) or "memory". In NODE_ENV=production with no
# Upstash credentials, rate-limited routes FAIL CLOSED (503) by design.
RATE_LIMIT_BACKEND=
# PRIVATE.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notifications -------------------------------------------------------
NOTIFICATION_EMAIL=
EMAIL_FROM=
# PRIVATE. Configure at most one delivery channel; blank = console log only.
# Customer receipts/confirmations need RESEND_API_KEY or SENDGRID_API_KEY
# (LEAD_WEBHOOK_URL only carries internal lead/vendor notifications).
RESEND_API_KEY=
SENDGRID_API_KEY=
LEAD_WEBHOOK_URL=

# --- Payment provider: Razorpay (all new payments) ------------------------
# Validated by src/lib/backend/config/env.ts. Payment routes return 503 until
# the four RAZORPAY_* values are present and consistent. Use TEST keys locally.
# Key ID (rzp_test_...). The only payment value ever sent to the browser, via
# the payment order API response — never as a NEXT_PUBLIC_ variable.
RAZORPAY_KEY_ID=
# PRIVATE.
RAZORPAY_KEY_SECRET=
# PRIVATE. Must differ from RAZORPAY_KEY_SECRET; use the secret of the TEST-mode
# webhook registered for your tunnel URL (…/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
# "test" or "live"; must match the RAZORPAY_KEY_ID prefix.
RAZORPAY_MODE=test
# Optional; if set it must be "razorpay".
PAYMENT_PROVIDER=
# PRIVATE. >= 32 random characters; enables POST /api/internal/payments/reconcile.
PAYMENT_RECONCILIATION_SECRET=
# Empty normally; "on" pauses NEW reservations and payment orders.
PAYMENTS_KILL_SWITCH=

# --- Legacy Cashfree (historical records only, no new payments) ------------
# PRIVATE. Only needed to verify late webhooks for historical Cashfree orders.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" or "production"
CASHFREE_ENVIRONMENT=
