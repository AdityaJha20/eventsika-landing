# Eventsika Environment Configuration Template
# Copy this file to .env.local and populate the values.

# Target notification recipient for leads & partner applications
NOTIFICATION_EMAIL=care@eventsika.in

# From email address (must be a verified sender in your email provider)
EMAIL_FROM="Eventsika Leads <care@eventsika.in>"

# Option 1: Resend API Key (Recommended - zero extra npm packages needed)
# RESEND_API_KEY=re_your_api_key_here

# Option 2: SendGrid API Key
# SENDGRID_API_KEY=SG.your_api_key_here

# Option 3: Custom Webhook URL (e.g., Zapier, Make, Telegram, Hostinger automation)
# LEAD_WEBHOOK_URL=https://your-webhook-endpoint.com/eventsika-leads

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# 1. Supabase Project Endpoint
# SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Authentication / Publishable Key (Client/SSR Session Cookies)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# 3. Server-Only Privileged Key (CRITICAL: Database persistence only, NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# Rate Limiting Configuration
# ==============================================================================
# Rate limiting backend: "upstash" (default) or "memory".
# In production, defaults to "upstash" (or "redis") and fails closed if credentials are missing.
#
# Set RATE_LIMIT_BACKEND=memory for single-instance hosting environments (e.g., Hostinger Node.js Web App)
# to run rate limiting without an external Upstash Redis instance.
#
# IMPORTANT CAVEATS FOR RATE_LIMIT_BACKEND=memory:
# - Counters are stored strictly in-process memory and reset whenever the server/process restarts.
# - Counters are NOT shared across multiple worker processes, cluster workers, or separate app instances.
# - Treat this as a temporary low-traffic deployment compromise, NOT distributed protection.
# RATE_LIMIT_BACKEND=memory

# Upstash Redis Configuration (Distributed Rate Limiting - Default Production Backend)
# CRITICAL: Server-only configuration. NEVER prefix with NEXT_PUBLIC_.
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ==============================================================================
# Cashfree Payment Gateway (Step 3 Foundation — Server-Only, NEVER expose to browser)
# ==============================================================================
# CASHFREE_APP_ID=your_cashfree_app_id_here
# CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# CASHFREE_ENVIRONMENT=sandbox
